# Discord Bot Token (from https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=your_bot_token_here

# Discord Server (Guild) ID
GUILD_ID=759834071454318612

# Separate bot that manages Programming Challenges and auto-posts an
# updating leaderboard every 60 seconds to the dashboard-configured channel.
# If left empty, the main bot keeps handling challenges (no auto leaderboard).
CHALLENGES_BOT_TOKEN=

# Voice presence bots tokens (comma-separated, each joins a channel set in dashboard)
VOICE_BOT_TOKENS=token1,token2,token3

# Dashboard Secret Key (change this to a random string)
DASHBOARD_SECRET_KEY=admin

# Admin User IDs (comma-separated) for dashboard access
ADMIN_IDS=759795574874308649

# Code judge API (Piston). Set this to your own whitelisted/self-hosted Piston
# instance base URL, e.g. https://piston.example.com/api/v2/piston
# When unset, the bot uses the free Compiler Explorer (godbolt.org) engine,
# which currently covers: C++, Java, C#, Go, Rust.
PISTON_URL=
